{
  "manifest_version": 3,
  "name": "PrencheJá",
  "version": "1.0",
  "description": "Envia apostas geradas em totoloto.lixo.dev para o carrinho do Jogos Santa Casa, com um clique.",
  "homepage_url": "https://totoloto.lixo.dev",
  "minimum_chrome_version": "117",
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PrencheJá",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["cookies"],
  "host_permissions": [
    "https://totoloto.lixo.dev/*",
    "https://www.jogossantacasa.pt/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://totoloto.lixo.dev/*",
        "http://localhost:*/*"
      ],
      "js": ["content.js"]
    }
  ]
}
