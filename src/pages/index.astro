      <!-- Main number heat map -->
      <div class="freq-section">
        <div class="freq-section-label has-tip" data-tip="Mapa de calor com a frequência histórica de cada número. Azul mais intenso = mais sorteado. Clique em qualquer número para ver todos os detalhes.">Frequência — Números (1–49)</div>
        <div class="freq-grid">
          {mainStats.map(s => (
            <div
              class="freq-cell"
              role="button"
              tabindex="0"
              aria-label={`Número ${s.number}, ${s.draws} saídas`}
              style={cellStyle(s.draws, maxMain, false)}
              data-num={s.number}
              data-draws={s.draws}
              data-pct={s.pct.toFixed(2)}
              data-last-draw={s.lastDraw}
              data-last-date={s.lastDate}
              data-absences={s.absences}
              data-type="main"
            >
              <span class="freq-num">{s.number}</span>
              <span class="freq-count">{s.draws}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Lucky number heat map -->
      {luckyStats.length > 0 && (
        <div class="freq-section">
          <div class="freq-section-label has-tip" data-tip="Mapa de calor para os 13 números da sorte. Laranja mais intenso = mais sorteado. Clique para ver detalhes de cada número.">Frequência — Número da Sorte (1–13)</div>
          <div class="freq-row">
            {luckyStats.map(s => (
              <div
                class="freq-cell"
                role="button"
                tabindex="0"
                aria-label={`Número da sorte ${s.number}, ${s.draws} saídas`}
                style={cellStyle(s.draws, maxLucky, true)}
                data-num={s.number}
                data-draws={s.draws}
                data-pct={s.pct.toFixed(2)}
                data-last-draw={s.lastDraw}
                data-last-date={s.lastDate}
                data-absences={s.absences}
                data-type="lucky"
              >
