---
import '../styles/main.css';
import archiveRaw from '../data/totoloto.jsonl?raw';

const commitSha = (import.meta.env.CF_PAGES_COMMIT_SHA as string | undefined)?.slice(0, 7);

interface Draw { id?: string; draw: string; date: string; numbers: number[]; lucky: number; }
const rawArchive: Draw[] = archiveRaw.trim().split('\n').map(l => JSON.parse(l));
const fmtDate = (iso: string) => iso.split('-').reverse().join('/');
const archive = rawArchive;
const N = archive.length;

// ── Odd / Even ───────────────────────────────
const oddDist = [0,1,2,3,4,5].map(k => ({
  k,
  count: archive.filter(d => d.numbers.filter(n => n % 2 !== 0).length === k).length,
}));
const avgOdd  = +(archive.reduce((s,d) => s + d.numbers.filter(n => n % 2 !== 0).length, 0) / N).toFixed(1);
const avgEven = +(5 - avgOdd).toFixed(1);

// ── High / Low (25–49 = high) ────────────────
const hiLoDist = [0,1,2,3,4,5].map(k => ({
  k,
  count: archive.filter(d => d.numbers.filter(n => n >= 25).length === k).length,
}));
const avgHigh = +(archive.reduce((s,d) => s + d.numbers.filter(n => n >= 25).length, 0) / N).toFixed(1);
const avgLow  = +(5 - avgHigh).toFixed(1);

// ── Sums ─────────────────────────────────────
const sums   = archive.map(d => d.numbers.reduce((a,b) => a+b, 0));
const sumMin = Math.min(...sums);
const sumMax = Math.max(...sums);
const sumAvg = Math.round(sums.reduce((a,b) => a+b, 0) / N);
const BUCKET = 20, BMIN = 15, NBUCKETS = 12;
const sumHist = Array.from({length: NBUCKETS}, (_, i) => {
  const lo = BMIN + i * BUCKET;
  return { lo, hi: lo + BUCKET, count: sums.filter(s => s >= lo && s < lo + BUCKET).length };
});
const sumHistMax = Math.max(...sumHist.map(b => b.count));

// ── Zones (decades) ──────────────────────────
const zones = [
  {label:'1–10',  lo:1,  hi:10},
  {label:'11–20', lo:11, hi:20},
  {label:'21–30', lo:21, hi:30},
  {label:'31–40', lo:31, hi:40},
  {label:'41–49', lo:41, hi:49},
];
const zoneStats = zones.map(z => ({
  ...z,
  avg: +(archive.reduce((s,d) => s + d.numbers.filter(n => n >= z.lo && n <= z.hi).length, 0) / N).toFixed(2),
}));
const zoneMax = Math.max(...zoneStats.map(z => z.avg));

// ── Consecutive pairs ────────────────────────
const consecDraws = archive.filter(d => {
  const s = [...d.numbers].sort((a,b) => a-b);
  return s.some((_,i) => i > 0 && s[i] - s[i-1] === 1);
}).length;
const consecPct = Math.round(consecDraws / N * 100);

// ── Carry-over between consecutive draws ────────
const carryDist = [0,1,2,3,4,5].map(k => {
  let count = 0;
  for (let i = 1; i < archive.length; i++) {
    const prev = new Set(archive[i-1].numbers);
    if (archive[i].numbers.filter(n => prev.has(n)).length === k) count++;
  }
  return { k, count };
});
const carryPairs = archive.length - 1;
const avgCarry = +(archive.slice(1).reduce((s, d, i) => {
  const prev = new Set(archive[i].numbers);
  return s + d.numbers.filter(n => prev.has(n)).length;
}, 0) / carryPairs).toFixed(2);
const luckyCarry = archive.slice(1).filter((d, i) => d.lucky === archive[i].lucky).length;
const luckyCarryPct = Math.round(luckyCarry / carryPairs * 100);

// ── Top co-occurring pairs ────────────────────
const pairFreq: Record<string, number> = {};
for (const d of archive) {
  const n = d.numbers;
  for (let i = 0; i < n.length; i++)
    for (let j = i+1; j < n.length; j++)
      { const k = `${n[i]}–${n[j]}`; pairFreq[k] = (pairFreq[k]||0) + 1; }
}
const sortedPairs = Object.entries(pairFreq).sort((a,b) => b[1]-a[1]);
const topPairs    = sortedPairs.slice(0, 12).map(([pair, count]) => ({pair, count}));
const bottomPairs = sortedPairs.slice(-12).reverse().map(([pair, count]) => ({pair, count}));

interface NumStat {
  number:   number;
  draws:    number;
  pct:      number;
  lastDraw: string;
  lastDate: string;
  absences: number;
}

let mainStats:  NumStat[] = [];
let luckyStats: NumStat[] = [];
let updatedAt = '';

try {
  const res = await fetch('https://www.jogossantacasa.pt/web/SCEstatisticas/totolotoN', {
    headers: { 'User-Agent': 'Mozilla/5.0 (compatible)' },
    signal: AbortSignal.timeout(8000),
  });
  const buf  = await res.arrayBuffer();
  const html = new TextDecoder('iso-8859-1').decode(buf);

  const rowRx = /<ul class="colums[^"]*">\s*<li>(\d+)<\/li><li>(\d+)<\/li><li>([\d,]+)<\/li><li>([^<]+)<\/li><li>([^<]+)<\/li><li>(\d+)<\/li>/g;
  const all: NumStat[] = [];
  let m: RegExpExecArray | null;
  while ((m = rowRx.exec(html)) !== null) {
    all.push({
      number:   parseInt(m[1]),
      draws:    parseInt(m[2]),
      pct:      parseFloat(m[3].replace(',', '.')),
      lastDraw: m[4].trim(),
      lastDate: m[5].trim(),
      absences: parseInt(m[6]),
    });
  }
  mainStats  = all.slice(0, 49);
  luckyStats = all.slice(49);

  const dm = html.match(/Dados atualizados em: ([\d/]+ [\d:]+)/);
  updatedAt = dm ? dm[1] : '';
} catch (_) {}

const hasData   = mainStats.length === 49;
const maxMain   = hasData ? Math.max(...mainStats.map(s => s.draws)) : 1;
const maxLucky  = luckyStats.length > 0 ? Math.max(...luckyStats.map(s => s.draws)) : 1;

const totalSorteios = hasData
  ? Math.round(mainStats.reduce((sum, s) => sum + s.draws, 0) / 5)
  : 0;
const mostFrequent = hasData ? mainStats.reduce((a, b) => b.draws    > a.draws    ? b : a) : null;
const mostAbsent   = hasData ? mainStats.reduce((a, b) => b.absences > a.absences ? b : a) : null;
const hotMain      = hasData ? [...mainStats].sort((a, b) => b.draws    - a.draws)    .slice(0, 5) : [];
const coldMain     = hasData ? [...mainStats].sort((a, b) => b.absences - a.absences) .slice(0, 5) : [];
const hotLucky     = luckyStats.length > 0 ? [...luckyStats].sort((a, b) => b.draws    - a.draws)    .slice(0, 5) : [];
const coldLucky    = luckyStats.length > 0 ? [...luckyStats].sort((a, b) => b.absences - a.absences) .slice(0, 5) : [];

// ── Last draw ────────────────────────────────
const lastDraw = archive[archive.length - 1];

// ── Smart picker data ────────────────────────
const sortedSums = [...sums].sort((a,b) => a-b);
const sumP10 = sortedSums[Math.floor(N * 0.10)];
const sumP90 = sortedSums[Math.floor(N * 0.90)];
const mainFreqW  = hasData ? mainStats.map(s => s.draws)        : Array(49).fill(1);
const luckyFreqW = luckyStats.length > 0 ? luckyStats.map(s => s.draws)        : Array(13).fill(1);
const mainAbsW   = hasData ? mainStats.map(s => s.absences + 1) : Array(49).fill(1);
const luckyAbsW  = luckyStats.length > 0 ? luckyStats.map(s => s.absences + 1) : Array(13).fill(1);

const SITE_URL = 'https://totoloto.lixo.dev'; // update when deployed

function cellStyle(draws: number, max: number, isLucky: boolean) {
  const intensity = draws / max;
  const alpha     = (intensity * 0.78 + 0.04).toFixed(2);
  const rgb       = isLucky ? '230,117,65' : '0,141,208';
  const textColor = intensity > 0.38 ? '#fff' : '#111';
  return `background:rgba(${rgb},${alpha});color:${textColor}`;
}
---

<!doctype html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Totoloto · Gerador de Apostas e Estatísticas | Portugal</title>
  <meta name="description" content="Gera apostas para o Totoloto com base em estatísticas históricas de mais de 1500 sorteios. Analisa frequências, padrões, pares e usa o gerador inteligente de chaves. Grátis e sem registo.">
  <meta name="keywords" content="Totoloto, gerador Totoloto, apostas Totoloto, números Totoloto, estatísticas Totoloto, Jogos Santa Casa, chaves Totoloto, Totoloto Portugal, número da sorte, gerador de números">
  <meta name="author" content="Hugo Conceição">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href={SITE_URL}>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={SITE_URL}>
  <meta property="og:locale" content="pt_PT">
  <meta property="og:title" content="Totoloto · Gerador de Apostas e Estatísticas">
  <meta property="og:description" content="Gera apostas para o Totoloto com base em estatísticas históricas de mais de 1500 sorteios. Analisa frequências, padrões, pares e usa o gerador inteligente de chaves.">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="Totoloto · Gerador de Apostas e Estatísticas">
  <meta name="twitter:description" content="Gera apostas para o Totoloto com base em estatísticas históricas de mais de 1500 sorteios.">

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Gerador de Apostas Totoloto",
    "description": "Ferramenta gratuita para gerar e analisar apostas do Totoloto com base em estatísticas históricas de mais de 1500 sorteios desde 2011.",
    "url": SITE_URL,
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Web",
    "inLanguage": "pt-PT",
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" },
    "author": { "@type": "Person", "name": "Hugo Conceição" },
    "about": {
      "@type": "Thing",
      "name": "Totoloto",
      "description": "Jogo de lotaria nacional operado pela Santa Casa da Misericórdia de Lisboa através dos Jogos Santa Casa"
    }
  })}></script>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/jetbrains-mono.woff2">
  <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/plus-jakarta-sans.woff2">
</head>
<body>

<div class="page">

  <div class="heading">
    <h1>Totoloto</h1>
    <p class="heading-sub">Gera apostas e explora estatísticas históricas de mais de {N.toLocaleString('pt')} sorteios do Totoloto desde 2011.</p>
  </div>

  <div class="layout">
  <!-- ── Col 1: generators ────────────────────── -->
  <div class="layout-col">

  <!-- ── Generator ───────────────────────────── -->
  <div class="card">
    <div class="card-header">
      <span class="card-label">Gerar Apostas</span>
    </div>
    <div class="card-body">
      <div class="field">
        <label for="lines-input">Número de chaves</label>
        <input id="lines-input" type="number" min="1" max="20" value="1" />
      </div>
      <button id="generate-btn" class="btn-primary" style="margin-top:.75rem">
        Gerar números
      </button>
    </div>
    <div id="results"></div>
  </div>

  <!-- ── Smart picker ────────────────────────── -->
  <div class="card">
    <div class="card-header">
      <span class="card-label">Aposta inteligente</span>
    </div>
    <div class="card-body">
      <div style="margin-bottom:.75rem">
        <div class="field-label">Estratégia</div>
        <div class="strategy-pills" id="strategy-pills">
          <button class="strategy-pill active" data-strategy="equilibrada">Equilibrada</button>
          <button class="strategy-pill" data-strategy="quente">Quente</button>
          <button class="strategy-pill" data-strategy="fria">Fria</button>
        </div>
        <div class="strategy-desc" id="strategy-desc">
          Filtra combinações que seguem os padrões mais frequentes: 2–3 ímpares, 2–3 altos, soma entre {sumP10} e {sumP90}.
        </div>
      </div>
      <!-- Last draw reference -->
      <div class="last-draw-row">
        <span class="last-draw-label">Último sorteio ({lastDraw.draw} · {fmtDate(lastDraw.date)})</span>
        <div class="last-draw-balls">
          {lastDraw.numbers.map(n => <span class="last-draw-ball">{n}</span>)}
          <span class="balls-sep">+</span>
          <span class="last-draw-ball last-draw-ball--lucky">{lastDraw.lucky}</span>
        </div>
      </div>

      <!-- Avoid repeats toggle -->
      <label class="avoid-row">
        <input type="checkbox" id="avoid-repeats" checked />
        <span>Evitar repetições do último sorteio</span>
      </label>

      <div class="field" style="margin-top:.75rem">
        <label for="smart-lines-input">Número de chaves</label>
        <input id="smart-lines-input" type="number" min="1" max="20" value="1" />
      </div>
      <button id="smart-btn" class="btn-primary" style="margin-top:.75rem">
        Gerar aposta inteligente
      </button>
    </div>
    <div id="smart-results"></div>
  </div>

  </div><!-- /layout-col left -->

  <!-- ── Col 2: historical stats ──────────────── -->
  <div class="layout-col">

  <!-- ── Statistics ──────────────────────────── -->
  {hasData && (
    <div class="card">
      <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;gap:.5rem">
        <span class="card-label">Estatísticas históricas</span>
        {updatedAt && <span class="stats-updated">{updatedAt}</span>}
      </div>

      <!-- Overview -->
      <div class="stat-chips">
        <div class="stat-chip has-tip" data-tip="Total de sorteios registados no arquivo desde março de 2011. Cada sorteio realiza-se às quartas-feiras e sábados.">
          <div class="stat-chip-label">Sorteios</div>
          <div class="stat-chip-val">{totalSorteios.toLocaleString('pt')}</div>
        </div>
        {mostFrequent && (
          <div class="stat-chip has-tip" data-tip="O número com mais saídas históricas. A diferença entre o mais e o menos frequente é normalmente pequena, confirmando a aleatoriedade dos sorteios.">
            <div class="stat-chip-label">Mais frequente</div>
            <div class="stat-chip-val" style="color:var(--blue)">{mostFrequent.number}</div>
            <div class="stat-chip-sub">{mostFrequent.draws}× · {mostFrequent.pct.toFixed(2)}%</div>
          </div>
        )}
        {mostAbsent && (
          <div class="stat-chip has-tip" data-tip="O número com mais sorteios consecutivos sem sair. Não significa que vá sair a seguir — cada sorteio é independente dos anteriores.">
            <div class="stat-chip-label">Mais ausente</div>
            <div class="stat-chip-val" style="color:var(--primary)">{mostAbsent.number}</div>
            <div class="stat-chip-sub">{mostAbsent.absences} sorteios</div>
          </div>
        )}
      </div>

      <!-- Main number heat map -->
      <div class="freq-section">
        <div class="freq-section-label has-tip" data-tip="Mapa de calor com a frequência histórica de cada número. Azul mais intenso = mais sorteado. Clique em qualquer número para ver todos os detalhes.">Frequência — Números (1–49)</div>
        <div class="freq-grid">
          {mainStats.map(s => (
            <div
              class="freq-cell"
              style={cellStyle(s.draws, maxMain, false)}
              data-num={s.number}
              data-draws={s.draws}
              data-pct={s.pct.toFixed(2)}
              data-last-draw={s.lastDraw}
              data-last-date={s.lastDate}
              data-absences={s.absences}
              data-type="main"
            >
              <span class="freq-num">{s.number}</span>
              <span class="freq-count">{s.draws}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Lucky number heat map -->
      {luckyStats.length > 0 && (
        <div class="freq-section">
          <div class="freq-section-label has-tip" data-tip="Mapa de calor para os 13 números da sorte. Laranja mais intenso = mais sorteado. Clique para ver detalhes de cada número.">Frequência — Número da Sorte (1–13)</div>
          <div class="freq-row">
            {luckyStats.map(s => (
              <div
                class="freq-cell"
                style={cellStyle(s.draws, maxLucky, true)}
                data-num={s.number}
                data-draws={s.draws}
                data-pct={s.pct.toFixed(2)}
                data-last-draw={s.lastDraw}
                data-last-date={s.lastDate}
                data-absences={s.absences}
                data-type="lucky"
              >
                <span class="freq-num freq-num-sm">{s.number}</span>
                <span class="freq-count">{s.draws}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Hot / Cold -->
      <div class="freq-section">

        <!-- Main numbers -->
        <div class="hc-group-label has-tip" data-tip="Top 5 números com mais saídas e top 5 com mais sorteios de ausência, calculados sobre o arquivo histórico completo.">Números (1–49)</div>
        <div class="hot-cold-grid">
          <div>
            <div class="hot-cold-label has-tip" style="color:var(--blue)" data-tip="Os 5 números principais sorteados mais vezes desde 2011.">▲ Mais frequentes</div>
            <div class="number-tags">
              {hotMain.map(s => (
                <div class="number-tag" style="background:var(--blue);color:#fff;border-color:var(--blue)">
                  <span>{s.number}</span>
                  <small>{s.draws}×</small>
                </div>
              ))}
            </div>
          </div>
          <div>
            <div class="hot-cold-label has-tip" style="color:var(--muted)" data-tip="Os 5 números que estão há mais sorteios consecutivos sem aparecer. Não implica maior probabilidade de sair.">▼ Mais ausentes</div>
            <div class="number-tags">
              {coldMain.map(s => (
                <div class="number-tag">
                  <span>{s.number}</span>
                  <small>{s.absences} sorteios</small>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Lucky numbers -->
        {hotLucky.length > 0 && (
          <div class="hc-lucky">
            <div class="hc-group-label has-tip" data-tip="Top 5 números da sorte com mais saídas e top 5 com mais ausências.">Número da Sorte (1–13)</div>
            <div class="hot-cold-grid">
              <div>
                <div class="hot-cold-label has-tip" style="color:var(--primary)" data-tip="Os 5 números da sorte sorteados mais vezes desde 2011.">▲ Mais frequentes</div>
                <div class="number-tags">
                  {hotLucky.map(s => (
                    <div class="number-tag" style="background:var(--primary);color:#fff;border-color:var(--primary)">
                      <span>{s.number}</span>
                      <small>{s.draws}×</small>
                    </div>
                  ))}
                </div>
              </div>
              <div>
                <div class="hot-cold-label has-tip" style="color:var(--muted)" data-tip="Os 5 números da sorte há mais sorteios sem aparecer.">▼ Mais ausentes</div>
                <div class="number-tags">
                  {coldLucky.map(s => (
                    <div class="number-tag">
                      <span>{s.number}</span>
                      <small>{s.absences} sorteios</small>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        )}

      </div>
    </div>
  )}

  </div><!-- /layout-col col2 -->

  <!-- ── Col 3: patterns ───────────────────────── -->
  <div class="layout-col layout-col--patterns">

  <!-- ── Patterns ────────────────────────────── -->
  <div class="card">
    <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;gap:.5rem">
      <span class="card-label">Padrões históricos</span>
      <span class="stats-updated">{N.toLocaleString('pt')} sorteios</span>
    </div>

    <!-- Overview chips -->
    <div class="stat-chips" style="grid-template-columns:repeat(4,1fr)">
      <div class="stat-chip has-tip" data-tip="Média de números ímpares por chave. O valor estatisticamente esperado é 2,5 em 5 números. Valores acima indicam tendência histórica para ímpares.">
        <div class="stat-chip-label">Méd. ímpares</div>
        <div class="stat-chip-val">{avgOdd}</div>
        <div class="stat-chip-sub">de 5</div>
      </div>
      <div class="stat-chip has-tip" data-tip="Média de números altos (25–49) por chave. O esperado é 2,5. Valores acima de 2,5 indicam tendência histórica para a metade superior do intervalo.">
        <div class="stat-chip-label">Méd. altos</div>
        <div class="stat-chip-val">{avgHigh}</div>
        <div class="stat-chip-sub">25–49</div>
      </div>
      <div class="stat-chip has-tip" data-tip={`Média da soma dos 5 números por sorteio. A soma teórica varia entre 15 (1+2+3+4+5) e 235 (45+…+49), com centro em 125. Mínimo histórico: ${sumMin}. Máximo: ${sumMax}.`}>
        <div class="stat-chip-label">Soma média</div>
        <div class="stat-chip-val">{sumAvg}</div>
        <div class="stat-chip-sub">{sumMin}–{sumMax}</div>
      </div>
      <div class="stat-chip has-tip" data-tip="Percentagem de sorteios com pelo menos um par de números consecutivos (ex: 14 e 15). Estatisticamente esperado em ~67% dos sorteios aleatórios — valores próximos confirmam aleatoriedade.">
        <div class="stat-chip-label">Com consecutivos</div>
        <div class="stat-chip-val">{consecPct}%</div>
        <div class="stat-chip-sub">dos sorteios</div>
      </div>
    </div>

    <!-- Carry-over between draws -->
    <div class="freq-section">
      <div class="freq-section-label has-tip" data-tip={`Quantos números do sorteio anterior voltaram a sair no sorteio seguinte. Média histórica: ${avgCarry} números repetidos nos 5 principais. O número da sorte repete em ${luckyCarryPct}% dos sorteios consecutivos.`}>
        Repetições entre sorteios consecutivos
      </div>

      <!-- Main numbers -->
      <div class="carry-sub-label">Números principais (0–5)</div>
      <div class="carry-grid">
        {carryDist.map(({k, count}) => {
          const pct = count / carryPairs * 100;
          return (
            <div class={`carry-cell ${k === 0 ? 'carry-cell--highlight' : ''}`}>
              <div class="carry-k">{k}</div>
              <div class="carry-bar-wrap">
                <div class="carry-bar-fill" style={`height:${pct.toFixed(1)}%`}></div>
              </div>
              <div class="carry-pct">{pct.toFixed(1)}%</div>
              <div class="carry-count">{count}×</div>
            </div>
          );
        })}
      </div>
      <div class="carry-meta" style="margin-bottom:.85rem">
        <span>Média: <strong>{avgCarry}</strong> repetições/sorteio</span>
      </div>

      <!-- Lucky number -->
      <div class="carry-sub-label">Número da sorte (0–1)</div>
      <div class="carry-grid" style="grid-template-columns:repeat(2,1fr);max-width:140px">
        {[
