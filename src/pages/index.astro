<!-- ── Generator + Smart picker script ─────────── -->
<script define:vars={{ mainFreqW, luckyFreqW, mainAbsW, luckyAbsW, sumP10, sumP90, lastDraw, last10 }}>

  // ── Helpers ─────────────────────────────────
  function pickNumbers(count, max) {
    const pool = Array.from({ length: max }, (_, i) => i + 1);
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    return pool.slice(0, count).sort((a, b) => a - b);
  }

  function weightedSample(weights, count) {
    const pool = weights.map((w, i) => ({ i, w: Math.max(w, 0.01) }));
    const result = [];
    while (result.length < count) {
      const total = pool.reduce((s, x) => s + x.w, 0);
      let r = Math.random() * total;
      for (const item of pool) {
        r -= item.w;
        if (r <= 0) { result.push(item.i + 1); item.w = 0; break; }
      }
    }
    return result.sort((a, b) => a - b);
  }

  function pickLucky(weights) {
    return weightedSample(weights, 1)[0];
  }

  // Equilibrada: rejection sampling with pattern filters
  function pickEquilibrada() {
    for (let t = 0; t < 2000; t++) {
      const pool = Array.from({ length: 49 }, (_, i) => i + 1);
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }
      const nums = pool.slice(0, 5).sort((a, b) => a - b);
      const odd  = nums.filter(n => n % 2 !== 0).length;
      const high = nums.filter(n => n >= 25).length;
      const sum  = nums.reduce((a, b) => a + b, 0);
      const decades = new Set(nums.map(n => Math.ceil(n / 10))).size;
      if (odd >= 2 && odd <= 3 && high >= 2 && high <= 3 && sum >= sumP10 && sum <= sumP90 && decades >= 3)
        return nums;
    }
    return weightedSample(Array(49).fill(1), 5);
  }

  // ── Smart strategy ───────────────────────────
  // For each number: weight = historical_prob × (1 + 0.6 × recency_deficit)
  // deficit = expected appearances in last 10 − actual appearances in last 10
  // Numbers below their expected recent frequency get boosted; over-represented ones are dampened.
  const { smartMainW, smartLuckyW } = (() => {
    const recentMain  = new Array(49).fill(0);
    const recentLucky = new Array(13).fill(0);
    for (const d of last10) {
      for (const n of d.numbers) recentMain[n - 1]++;
      recentLucky[d.lucky - 1]++;
    }
    const n = mainFreqW.reduce((s, w) => s + w, 0) / 5 || 1;
    const l = luckyFreqW.reduce((s, w) => s + w, 0) || 1;
    return {
      smartMainW: mainFreqW.map((freq, i) => {
        const p = freq / n;
        return Math.max(0.01, p * (1 + 0.6 * (p * last10.length - recentMain[i])));
      }),
      smartLuckyW: luckyFreqW.map((freq, i) => {
        const p = freq / l;
        return Math.max(0.01, p * (1 + 0.6 * (p * last10.length - recentLucky[i])));
      }),
    };
  })();

  function pickSmart() {
    for (let t = 0; t < 2000; t++) {
      const nums    = weightedSample(smartMainW, 5);
      const odd     = nums.filter(n => n % 2 !== 0).length;
      const high    = nums.filter(n => n >= 25).length;
      const sum     = nums.reduce((a, b) => a + b, 0);
      const decades = new Set(nums.map(n => Math.ceil(n / 10))).size;
      if (odd >= 2 && odd <= 3 && high >= 2 && high <= 3 && sum >= sumP10 && sum <= sumP90 && decades >= 3)
        return nums;
    }
    return weightedSample(smartMainW, 5);
  }

  const strategies = {
    'aleatória':  { pick: () => pickNumbers(5, 49),           luckyW: Array(13).fill(1) },
    equilibrada:  { pick: pickEquilibrada,                    luckyW: luckyFreqW },
    quente:       { pick: () => weightedSample(mainFreqW, 5), luckyW: luckyFreqW },
    fria:         { pick: () => weightedSample(mainAbsW,  5), luckyW: luckyAbsW  },
    smart:        { pick: pickSmart,                          luckyW: smartLuckyW },
  };

  const descs = {
    'aleatória':  'Gera 5 números e 1 número da sorte completamente ao acaso, sem qualquer filtro estatístico.',
    equilibrada:  `Filtra combinações que seguem os padrões mais frequentes: 2–3 ímpares, 2–3 altos, soma entre ${sumP10} e ${sumP90}.`,
    quente:       'Favorece números com mais saídas históricas — os mais frequentes do arquivo.',
    fria:         'Favorece números com mais sorteios de ausência — os mais "atrasados" historicamente.',
    smart:        `Combina frequência histórica com os últimos ${last10.length} sorteios: pondera números abaixo da sua média recente e aplica os filtros de equilíbrio da estratégia Equilibrada.`,
  };

  const SMART_REFRESH_ICON = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>`;
  const CART_ADD_ICON    = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.2,9h1.6V6.8H16V5.2H13.8V3H12.2V5.2H10V6.8h2.2Z"/><path d="M20,5v5.5L7.45,12.72,5,3H1.25a1,1,0,0,0,0,2H3.47L6.7,18H20V16H8.26l-.33-1.33L22,12.18V5ZM7,19a1.5,1.5,0,1,0,1.5,1.5A1.5,1.5,0,0,0,7,19Zm12,0a1.5,1.5,0,1,0,1.5,1.5A1.5,1.5,0,0,0,19,19Z"/></svg>`;
  const CART_REMOVE_ICON = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16,5.2H10V6.8h6ZM20,5v5.5L7.45,12.72,5,3H1.25a1,1,0,0,0,0,2H3.47L6.7,18H20V16H8.26l-.33-1.33L22,12.18V5ZM7,19a1.5,1.5,0,1,0,1.5,1.5A1.5,1.5,0,0,0,7,19Zm12,0a1.5,1.5,0,1,0,1.5,1.5A1.5,1.5,0,0,0,19,19Z"/></svg>`;
  const TRASH_ICON = `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>`;

  // ── Annotation ──────────────────────────────
  function annotate(nums) {
    const odd  = nums.filter(n => n % 2 !== 0).length;
    const even = 5 - odd;
    const high = nums.filter(n => n >= 25).length;
    const low  = 5 - high;
    const sum  = nums.reduce((a, b) => a + b, 0);
    const oddOk  = odd >= 2 && odd <= 3;
    const highOk = high >= 2 && high <= 3;
    const sumOk  = sum >= sumP10 && sum <= sumP90;
    return `<div class="chave-annotation">
      <span class="${oddOk  ? 'ann-ok' : 'ann-warn'}">${odd}í+${even}p</span>
      <span class="${highOk ? 'ann-ok' : 'ann-warn'}">${low}bx+${high}alt</span>
      <span class="${sumOk  ? 'ann-ok' : 'ann-warn'}">Σ ${sum}</span>
      <button class="btn-refresh" style="margin-left:auto" title="Gerar nova chave" aria-label="Gerar nova chave">${SMART_REFRESH_ICON}</button>
      <button class="btn-add-cart" aria-label="Adicionar ao carrinho" title="Adicionar ao carrinho">${CART_ADD_ICON}</button>
      <button class="btn-remove-bet btn-refresh" aria-label="Remover chave" title="Remover chave">${TRASH_ICON}</button>
    </div>`;
  }

  // ── Render ───────────────────────────────────
  function renderSmartLine(nums, lucky, index, strategy) {
    const balls = nums.map(n => `<span class="ball">${n}</span>`).join('');
    const luckyBall = `<span class="ball ball--lucky">${lucky}</span>`;
    return `
      <div class="bet-entry" data-numbers="${nums.join(',')}" data-lucky="${lucky}" data-index="${index}">
        <div class="line" aria-label="Chave ${index + 1}">
          <span class="line-label">Chave ${index + 1}<span class="line-strategy">${strategy}</span></span>
          <div class="balls">${balls}<span class="balls-sep">+</span>${luckyBall}</div>
        </div>
        ${annotate(nums)}
      </div>`;
  }

  // ── State ────────────────────────────────────
  let currentStrategy = 'aleatória';
  let sharedLucky = null;

  function getLuckyForBet(luckyW) {
    if (document.getElementById('fixed-lucky').checked) {
      if (sharedLucky === null) sharedLucky = pickLucky(luckyW);
      return sharedLucky;
    }
    return pickLucky(luckyW);
  }

  function pickWithFilter(excluded) {
    const { pick } = strategies[currentStrategy];
    for (let t = 0; t < 500; t++) {
      const nums = pick();
      if (!nums.some(n => excluded.has(n))) return nums;
    }
    return strategies[currentStrategy].pick();
  }

  // Strategy pills
  document.querySelectorAll('.strategy-pill').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.strategy-pill').forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed', 'true');
      currentStrategy = btn.dataset.strategy;
      document.getElementById('strategy-desc').textContent = descs[currentStrategy];
      if (document.getElementById('fixed-lucky').checked) {
        sharedLucky = pickLucky(strategies[currentStrategy].luckyW);
      }
    });
  });

  document.getElementById('fixed-lucky').addEventListener('change', function() {
    const { luckyW } = strategies[currentStrategy];
    if (this.checked) {
      const first = results.querySelector('.bet-entry');
      sharedLucky = first ? Number(first.dataset.lucky) : pickLucky(luckyW);
      results.querySelectorAll('.bet-entry').forEach(entry => {
        entry.dataset.lucky = String(sharedLucky);
        const luckyBall = entry.querySelector('.ball--lucky');
        if (luckyBall) luckyBall.textContent = String(sharedLucky);
      });
      syncBetButtons();
    } else {
      sharedLucky = null;
    }
  });

  // Stepper buttons
  const linesInput = document.getElementById('smart-lines-input');
  const results    = document.getElementById('smart-results');

  function getExcluded() {
    const avoidRepeat = document.getElementById('avoid-repeats').checked;
    return avoidRepeat ? new Set(lastDraw.numbers) : new Set();
  }
  function nextIndex() {
    const entries = results.querySelectorAll('.bet-entry');
    return entries.length > 0
      ? Math.max(...[...entries].map(e => parseInt(e.dataset.index, 10))) + 1
      : 0;
  }

  // Restore saved bets or auto-generate first row
  (function() {
    let saved = [];
    try { saved = JSON.parse(localStorage.getItem('jsc-cart') || '[]'); } catch (e) {}
    const myBets = saved.filter((b) => b.game === 'totoloto');
    if (myBets.length > 0) {
      myBets.forEach((bet, i) => {
        const tmp = document.createElement('div');
        tmp.innerHTML = renderSmartLine(bet.numbers, bet.lucky, i, bet.strategy || '');
        results.appendChild(tmp.firstElementChild);
      });
    } else {
      const { luckyW } = strategies[currentStrategy];
      const tmp = document.createElement('div');
      tmp.innerHTML = renderSmartLine(pickWithFilter(getExcluded()), getLuckyForBet(luckyW), 0, currentStrategy);
      results.appendChild(tmp.firstElementChild);
    }
    linesInput.value = rowCount();
  })();

  function rowCount() { return results.querySelectorAll('.bet-entry').length; }

  function addRow() {
    const { luckyW } = strategies[currentStrategy];
    const tmp = document.createElement('div');
    tmp.innerHTML = renderSmartLine(pickWithFilter(getExcluded()), getLuckyForBet(luckyW), nextIndex(), currentStrategy);
    results.appendChild(tmp.firstElementChild);
    linesInput.value = rowCount();
  }

  function removeLastRow() {
    const entries = results.querySelectorAll('.bet-entry');
    if (entries.length > 1) {
      entries[entries.length - 1].remove();
      linesInput.value = rowCount();
    }
  }

  function syncRows(target) {
    const current = rowCount();
    if (target > current) {
      for (let i = current; i < target; i++) addRow();
    } else if (target < current) {
      const entries = [...results.querySelectorAll('.bet-entry')];
      entries.slice(target).forEach(e => e.remove());
      linesInput.value = rowCount();
    }
  }

  document.getElementById('lines-dec').addEventListener('click', () => { if (rowCount() > 1) removeLastRow(); });
  document.getElementById('lines-inc').addEventListener('click', () => { if (rowCount() < 20) addRow(); });

  linesInput.addEventListener('change', () => {
    const target = Math.max(1, Math.min(20, parseInt(linesInput.value, 10) || 1));
    linesInput.value = target;
    syncRows(target);
  });

  // Refresh / remove individual smart bet
  document.getElementById('smart-results').addEventListener('click', e => {
    if (e.target.closest('.btn-remove-bet')) {
      const entry = e.target.closest('.bet-entry');
      if (entry) { entry.remove(); linesInput.value = rowCount(); }
      return;
    }
    const btn = e.target.closest('.btn-refresh');
    if (!btn) return;
    const entry = btn.closest('.bet-entry');
    const index = parseInt(entry.dataset.index, 10);
    const avoidRepeat = document.getElementById('avoid-repeats').checked;
    const excluded    = avoidRepeat ? new Set(lastDraw.numbers) : new Set();
    const { luckyW }  = strategies[currentStrategy];
    const tmp = document.createElement('div');
    tmp.innerHTML = renderSmartLine(pickWithFilter(excluded), getLuckyForBet(luckyW), index, currentStrategy);
    entry.replaceWith(tmp.firstElementChild);
  });
</script>

<!-- ── Cart script ──────────────────────────── -->
<script>
  // ── State ────────────────────────────────────
  const CART_KEY = 'jsc-cart';
  const MY_GAME = 'totoloto';
  const BET_PRICES: Record<string, number> = { totoloto: 1.00, euromilhoes: 2.50, eurodreams: 2.50 };
  const GAME_LABELS: Record<string, string> = { totoloto: 'Totoloto', euromilhoes: 'Euromilhões', eurodreams: 'EuroDreams' };
  const BALL_COLORS: Record<string, string> = { totoloto: '#008dd0', euromilhoes: '#004f93', eurodreams: '#6e368c' };
  const cart: { game: string; numbers: number[]; stars?: number[]; lucky?: number; dream?: number }[] = (() => {
    try { return JSON.parse(localStorage.getItem(CART_KEY) || '[]'); } catch { return []; }
  })();

  const cartToggle     = document.getElementById('cart-toggle') as HTMLButtonElement;
  const cartPanel      = document.getElementById('cart-panel')!;
  const cartItemsEl    = document.getElementById('cart-items')!;
  const cartBadgeEl    = document.getElementById('cart-badge')!;
  const cartTotalEl    = document.getElementById('cart-total')!;
  const checkoutBtn    = document.getElementById('checkout-btn') as HTMLButtonElement;
  const checkoutStatus = document.getElementById('checkout-status')!;
  const smartResults   = document.getElementById('smart-results')!;
  const editOverlay    = document.getElementById('edit-modal-overlay')!;

  // ── Extension detection ───────────────────────
  checkoutBtn.disabled = true;
  checkoutStatus.textContent = 'Extensão Chrome não instalada';
  checkoutStatus.className = 'checkout-status err';

  const onExtReady = (e: MessageEvent) => {
    if (e.origin !== location.origin) return;
    if (e.data?.type !== 'JSC_EXT_READY') return;
    checkoutBtn.disabled = false;
    checkoutStatus.textContent = '';
    checkoutStatus.className = 'checkout-status';
    window.removeEventListener('message', onExtReady);
  };
  window.addEventListener('message', onExtReady);
  // Ping the extension — if it loaded first it will respond; if it loads
  // later it will announce itself via JSC_EXT_READY automatically.
  window.postMessage({ type: 'JSC_EXT_PING' }, '*');

  function renderCart() {
    localStorage.setItem(CART_KEY, JSON.stringify(cart));
    const n = cart.length;

    if (n > 0 && !checkoutBtn.disabled) {
      checkoutStatus.textContent = '';
      checkoutStatus.className = 'checkout-status';
    }
    cartBadgeEl.textContent = String(n);
    cartBadgeEl.hidden = n === 0;
    const total = cart.reduce((sum, b) => sum + (BET_PRICES[b.game] || 0), 0);
    cartTotalEl.textContent = n > 0
      ? `${n} aposta${n > 1 ? 's' : ''} · ${total.toLocaleString('pt-PT', { style: 'currency', currency: 'EUR' })}`
      : '';
    cartToggle.classList.toggle('has-items', n > 0);
    if (n === 0) { cartPanel.hidden = true; cartToggle.setAttribute('aria-expanded', 'false'); }
    checkoutBtn.hidden = n === 0;
    (document.getElementById('cart-clear') as HTMLButtonElement).hidden = n === 0;

    const gameCounters: Record<string, number> = {};
    cartItemsEl.innerHTML = cart.map((bet, i) => {
      if (!gameCounters[bet.game]) gameCounters[bet.game] = 0;
      gameCounters[bet.game]++;
      const chave = gameCounters[bet.game];
      const label = `${GAME_LABELS[bet.game] || bet.game} · ${chave}`;
      const ballColor = BALL_COLORS[bet.game] || '#008dd0';
      const balls = bet.numbers.map(n => `<span class="cart-ball" style="background:${ballColor}">${n}</span>`).join('');
      let secondary = '';
      if (bet.game === 'euromilhoes' && bet.stars) {
        secondary = bet.stars.map(s => `<span class="cart-ball cart-ball--lucky">${s}</span>`).join('');
      } else if (bet.game === 'totoloto' && bet.lucky != null) {
        secondary = `<span class="cart-ball cart-ball--lucky">${bet.lucky}</span>`;
      } else if (bet.game === 'eurodreams' && bet.dream != null) {
        secondary = `<span class="cart-ball cart-ball--lucky">${bet.dream}</span>`;
      }
      return `
        <div class="cart-item" data-game="${bet.game}">
          <span class="cart-item-label">${label}</span>
          <div class="cart-balls" data-edit-idx="${i}" tabindex="0" role="button" aria-label="Editar aposta ${i + 1}">${balls}<span class="cart-balls-sep">+</span>${secondary}</div>
          <button class="btn-cart-remove" data-idx="${i}" aria-label="Remover aposta ${i + 1}">✕</button>
        </div>`;
    }).join('');

    cartItemsEl.querySelectorAll<HTMLButtonElement>('[data-idx]').forEach(btn => {
      btn.addEventListener('click', e => {
        e.stopPropagation();
        cart.splice(Number(btn.dataset.idx), 1);
        renderCart();
      });
    });

    cartItemsEl.querySelectorAll<HTMLElement>('[data-edit-idx]').forEach(el => {
      el.addEventListener('click', e => {
        e.stopPropagation();
        openEditModal(Number(el.dataset.editIdx));
      });
      el.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openEditModal(Number(el.dataset.editIdx)); }
      });
    });

    syncBetButtons();
  }

  function openCart() {
    cartPanel.hidden = false;
    cartToggle.setAttribute('aria-expanded', 'true');
    const first = cartPanel.querySelector<HTMLElement>('button, [href], input, [tabindex]:not([tabindex="-1"])');
    first?.focus();
  }

  function closeCart() {
    cartPanel.hidden = true;
    cartToggle.setAttribute('aria-expanded', 'false');
    cartToggle.focus();
  }

  // ── Toggle panel ──────────────────────────────
  cartToggle.addEventListener('click', e => {
    e.stopPropagation();
    if (cart.length === 0) {
      cartItemsEl.innerHTML = '<div class="cart-success"><span>O carrinho está vazio.</span></div>';
    }
    if (cartPanel.hidden) openCart(); else closeCart();
  });

  document.addEventListener('click', e => {
    if (!cartPanel.hidden && !cartPanel.contains(e.target as Node) && !editOverlay.contains(e.target as Node)) {
      closeCart();
    }
  });

  cartPanel.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') closeCart();
  });

  // ── Edit bet modal ────────────────────────────
  const EDIT_CONFIGS: Record<string, { mainMax: number; mainCount: number; mainCols: number; secondaryLabel: string; secondaryMax: number; secondaryCount: number; secondaryCols: number; secondaryName: string }> = {
    totoloto:    { mainMax: 49, mainCount: 5, mainCols: 7,  secondaryLabel: 'Sorte (1–13)',    secondaryMax: 13, secondaryCount: 1, secondaryCols: 7,  secondaryName: 'sorte'    },
    euromilhoes: { mainMax: 50, mainCount: 5, mainCols: 6, secondaryLabel: 'Estrelas (1–12)', secondaryMax: 12, secondaryCount: 2, secondaryCols: 6,  secondaryName: 'estrelas' },
    eurodreams:  { mainMax: 40, mainCount: 6, mainCols: 8,  secondaryLabel: 'Sonho (1–5)',     secondaryMax: 5,  secondaryCount: 1, secondaryCols: 5,  secondaryName: 'sonho'    },
  };

  let editBetIdx = -1;
  let editGame = '';
  let editTarget: 'cart' | 'entry' = 'cart';
  let editEntryEl: HTMLElement | null = null;
  let editMainSel = new Set<number>();
  let editSecondarySel = new Set<number>();

  const editTitleEl   = document.getElementById('edit-modal-title')!;
  const editBody      = document.getElementById('edit-modal-body')!;
  const editCountEl   = document.getElementById('edit-modal-count')!;
  const editStatsEl      = document.getElementById('edit-modal-stats')!;
  const editClose     = document.getElementById('edit-modal-close')!;
  const editCancel    = document.getElementById('edit-modal-cancel')!;
  const editSaveBtn   = document.getElementById('edit-modal-save') as HTMLButtonElement;

  function openEditModal(betIdx: number) {
    const bet = cart[betIdx];
    if (!bet || !EDIT_CONFIGS[bet.game]) return;
    editBetIdx = betIdx;
    editGame = bet.game;
    editTarget = 'cart';
    editEntryEl = null;
    editMainSel = new Set(bet.numbers);
    if (bet.game === 'euromilhoes') editSecondarySel = new Set(bet.stars ?? []);
    else if (bet.game === 'totoloto') editSecondarySel = new Set(bet.lucky != null ? [bet.lucky] : []);
    else editSecondarySel = new Set(bet.dream != null ? [bet.dream] : []);

    const gc: Record<string, number> = {};
    for (let i = 0; i <= betIdx; i++) gc[cart[i].game] = (gc[cart[i].game] || 0) + 1;
    editTitleEl.textContent = `${GAME_LABELS[bet.game]} · Chave ${gc[bet.game]}`;

    renderEditBody();
    editOverlay.hidden = false;
    editSaveBtn.focus();
  }

  function openEditModalForEntry(entry: HTMLElement) {
    editBetIdx = -1;
    editGame = MY_GAME;
    editTarget = 'entry';
    editEntryEl = entry;
    editMainSel = new Set(entry.dataset.numbers!.split(',').map(Number));
    if (MY_GAME === 'euromilhoes') {
      editSecondarySel = new Set((entry.dataset.stars || '').split(',').map(Number).filter(Boolean));
    } else if (MY_GAME === 'totoloto') {
      const lucky = Number(entry.dataset.lucky);
      editSecondarySel = lucky ? new Set([lucky]) : new Set();
    } else {
      const dream = Number(entry.dataset.dream);
      editSecondarySel = dream ? new Set([dream]) : new Set();
    }
    editTitleEl.textContent = `Chave ${Number(entry.dataset.index) + 1}`;
    renderEditBody();
    editOverlay.hidden = false;
    editSaveBtn.focus();
  }

  function renderEditBody() {
    const cfg = EDIT_CONFIGS[editGame];
    const mainColor = BALL_COLORS[editGame] || '#008dd0';

    const mainGrid = Array.from({ length: cfg.mainMax }, (_, i) => {
      const n = i + 1;
      const sel = editMainSel.has(n);
      return `<div class="ball${sel ? ' selected' : ''}" data-n="${n}" data-type="main" role="button" tabindex="0" aria-pressed="${sel}"${sel ? ` style="background:${mainColor}"` : ''}>${n}</div>`;
    }).join('');

    const secGrid = Array.from({ length: cfg.secondaryMax }, (_, i) => {
      const n = i + 1;
      const sel = editSecondarySel.has(n);
      return `<div class="ball${sel ? ' selected' : ''}" data-n="${n}" data-type="secondary" role="button" tabindex="0" aria-pressed="${sel}"${sel ? ' style="background:var(--primary)"' : ''}>${n}</div>`;
    }).join('');

    editBody.innerHTML = `
      <div>
        <div class="edit-modal-section-label">Números (1–${cfg.mainMax})</div>
        <div class="edit-modal-grid" style="grid-template-columns:repeat(${cfg.mainCols},40px)">${mainGrid}</div>
      </div>
      <div>
        <div class="edit-modal-section-label">${cfg.secondaryLabel}</div>
        <div class="edit-modal-grid" style="grid-template-columns:repeat(${cfg.secondaryCols},40px)">${secGrid}</div>
      </div>`;

    editBody.querySelectorAll<HTMLElement>('.ball[data-n]').forEach(ball => {
      ball.addEventListener('click', () => toggleEditBall(ball));
      ball.addEventListener('keydown', e => {
        if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); toggleEditBall(ball); }
      });
    });

    updateEditCount();
  }

  function toggleEditBall(ball: HTMLElement) {
    const n = Number(ball.dataset.n);
    const cfg = EDIT_CONFIGS[editGame];
    const mainColor = BALL_COLORS[editGame] || '#008dd0';

    if (ball.dataset.type === 'main') {
      if (editMainSel.has(n)) {
        editMainSel.delete(n);
        ball.classList.remove('selected');
        ball.style.background = '';
      } else {
        if (editMainSel.size >= cfg.mainCount) return;
        editMainSel.add(n);
        ball.classList.add('selected');
        ball.style.background = mainColor;
      }
      ball.setAttribute('aria-pressed', String(editMainSel.has(n)));
    } else {
      if (editSecondarySel.has(n)) {
        editSecondarySel.delete(n);
        ball.classList.remove('selected');
        ball.style.background = '';
      } else {
        if (cfg.secondaryCount === 1) {
          editSecondarySel.clear();
          editBody.querySelectorAll<HTMLElement>('[data-type="secondary"].selected').forEach(b => {
            b.classList.remove('selected'); b.style.background = ''; b.setAttribute('aria-pressed', 'false');
          });
        } else if (editSecondarySel.size >= cfg.secondaryCount) {
          return;
        }
        editSecondarySel.add(n);
        ball.classList.add('selected');
        ball.style.background = 'var(--primary)';
      }
      ball.setAttribute('aria-pressed', String(editSecondarySel.has(n)));
    }
    updateEditCount();
  }

  function updateEditCount() {
    const cfg = EDIT_CONFIGS[editGame];
    editCountEl.textContent = `${editMainSel.size}/${cfg.mainCount} números · ${editSecondarySel.size}/${cfg.secondaryCount} ${cfg.secondaryName}`;
    editSaveBtn.disabled = editMainSel.size !== cfg.mainCount || editSecondarySel.size !== cfg.secondaryCount;
    const nums = Array.from(editMainSel);
    if (nums.length === 0) { editStatsEl.innerHTML = ''; return; }
    const mid    = Math.floor(cfg.mainMax / 2);
    const odd    = nums.filter(n => n % 2 !== 0).length;
    const high   = nums.filter(n => n > mid).length;
    const sum    = nums.reduce((a, b) => a + b, 0);
    const isED   = editGame === 'eurodreams';
    const oddOk  = isED ? (odd >= 2 && odd <= 4) : (odd >= 2 && odd <= 3);
    const highOk = isED ? (high >= 2 && high <= 4) : (high >= 2 && high <= 3);
    const _p10   = Number(editOverlay.dataset.sumP10);
    const _p90   = Number(editOverlay.dataset.sumP90);
    const sumOk  = sum >= _p10 && sum <= _p90;
    editStatsEl.innerHTML =
      `<span class="${oddOk  ? 'ann-ok' : 'ann-warn'}">${odd}í+${nums.length - odd}p</span>` +
      `<span class="${highOk ? 'ann-ok' : 'ann-warn'}">${nums.length - high}bx+${high}alt</span>` +
      `<span class="${sumOk  ? 'ann-ok' : 'ann-warn'}">Σ ${sum}</span>`;
  }

  function closeEditModal() {
    editOverlay.hidden = true;
    editBetIdx = -1;
    editEntryEl = null;
  }

  editClose.addEventListener('click', closeEditModal);
  editCancel.addEventListener('click', closeEditModal);
  editOverlay.addEventListener('click', e => { if (e.target === editOverlay) closeEditModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !editOverlay.hidden) { e.stopPropagation(); closeEditModal(); } });

  editSaveBtn.addEventListener('click', () => {
    const nums = Array.from(editMainSel).sort((a, b) => a - b);
    const sec  = Array.from(editSecondarySel).sort((a, b) => a - b);
    if (editTarget === 'cart') {
      if (editBetIdx < 0 || editBetIdx >= cart.length) return;
      const bet = cart[editBetIdx];
      bet.numbers = nums;
      if (bet.game === 'euromilhoes') bet.stars = sec;
      else if (bet.game === 'totoloto') bet.lucky = sec[0];
      else bet.dream = sec[0];
      closeEditModal();
      renderCart();
    } else if (editEntryEl) {
      editEntryEl.dataset.numbers = nums.join(',');
      if (MY_GAME === 'euromilhoes') editEntryEl.dataset.stars = sec.join(',');
      else if (MY_GAME === 'totoloto') editEntryEl.dataset.lucky = String(sec[0]);
      else editEntryEl.dataset.dream = String(sec[0]);
      const mainBalls = nums.map(n => `<span class="ball">${n}</span>`).join('');
      const secBalls = MY_GAME === 'euromilhoes'
        ? sec.map(s => `<span class="ball ball--lucky">${s}</span>`).join('')
        : `<span class="ball ball--lucky">${sec[0]}</span>`;
      editEntryEl.querySelector('.balls')!.innerHTML = `${mainBalls}<span class="balls-sep">+</span>${secBalls}`;
      closeEditModal();
      syncBetButtons();
    }
  });

  const CART_ADD_ICON    = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.2,9h1.6V6.8H16V5.2H13.8V3H12.2V5.2H10V6.8h2.2Z"/><path d="M20,5v5.5L7.45,12.72,5,3H1.25a1,1,0,0,0,0,2H3.47L6.7,18H20V16H8.26l-.33-1.33L22,12.18V5ZM7,19a1.5,1.5,0,1,0,1.5,1.5A1.5,1.5,0,0,0,7,19Zm12,0a1.5,1.5,0,1,0,1.5,1.5A1.5,1.5,0,0,0,19,19Z"/></svg>`;
  const CART_REMOVE_ICON = `<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16,5.2H10V6.8h6ZM20,5v5.5L7.45,12.72,5,3H1.25a1,1,0,0,0,0,2H3.47L6.7,18H20V16H8.26l-.33-1.33L22,12.18V5ZM7,19a1.5,1.5,0,1,0,1.5,1.5A1.5,1.5,0,0,0,7,19Zm12,0a1.5,1.5,0,1,0,1.5,1.5A1.5,1.5,0,0,0,19,19Z"/></svg>`;

  // ── Add to cart via event delegation ─────────
  function syncBetButtons() {
    let allAdded = true;
    document.querySelectorAll<HTMLElement>('[data-numbers]').forEach(entry => {
      const btn = entry.querySelector<HTMLButtonElement>('.btn-add-cart');
      if (!btn) return;
      const numbers = entry.dataset.numbers!.split(',').map(Number);
      const lucky   = Number(entry.dataset.lucky);
      const inCart  = cart.some(b => b.game === MY_GAME && b.numbers.join() === numbers.join() && b.lucky === lucky);
      btn.innerHTML = inCart ? CART_REMOVE_ICON : CART_ADD_ICON;
      const cartLabel = inCart ? 'Remover do carrinho' : 'Adicionar ao carrinho';
      btn.setAttribute('aria-label', cartLabel);
      btn.title = cartLabel;
      btn.classList.toggle('added', inCart);
      if (!inCart) allAdded = false;
    });
    const addAllBtn = document.getElementById('btn-add-all') as HTMLButtonElement;
    if (addAllBtn) {
      addAllBtn.textContent = allAdded ? '✓ todas' : '+ todas';
      addAllBtn.classList.toggle('added', allAdded);
    }
  }

  function setupAddListeners(containerId: string) {
    document.getElementById(containerId)!.addEventListener('click', e => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.btn-add-cart');
      if (!btn) return;
      const entry = btn.closest<HTMLElement>('[data-numbers]');
      if (!entry) return;
      const numbers = entry.dataset.numbers!.split(',').map(Number);
      const lucky   = Number(entry.dataset.lucky);
      const idx = cart.findIndex(b => b.game === MY_GAME && b.numbers.join() === numbers.join() && b.lucky === lucky);
      if (idx === -1) {
        cart.push({ game: MY_GAME, numbers, lucky });
      } else {
        cart.splice(idx, 1);
      }
      renderCart();
      syncBetButtons();
    });
  }

  function setupEditListeners(containerId: string) {
    document.getElementById(containerId)!.addEventListener('click', e => {
      const ballsEl = (e.target as HTMLElement).closest<HTMLElement>('.balls');
      if (!ballsEl) return;
      const entry = ballsEl.closest<HTMLElement>('[data-numbers]');
      if (!entry) return;
      e.stopPropagation();
      openEditModalForEntry(entry);
    });
  }

  setupAddListeners('smart-results');
  setupEditListeners('smart-results');
  renderCart();

  // ── Add all to cart ───────────────────────────
  const resultsHeader = document.getElementById('smart-results-header')!;

  new MutationObserver(() => {
    const hasRows = smartResults.querySelectorAll('.bet-entry').length > 0;
    resultsHeader.hidden = !hasRows;
    const addAllBtn = document.getElementById('btn-add-all') as HTMLButtonElement;
    addAllBtn.textContent = '+ todas';
    addAllBtn.classList.remove('added');
  }).observe(smartResults, { childList: true });

  document.getElementById('btn-add-all')!.addEventListener('click', () => {
    smartResults.querySelectorAll<HTMLElement>('[data-numbers]').forEach(entry => {
      const numbers = entry.dataset.numbers!.split(',').map(Number);
      const lucky   = Number(entry.dataset.lucky);
      const alreadyIn = cart.some(b => b.game === MY_GAME && b.numbers.join() === numbers.join() && b.lucky === lucky);
      if (!alreadyIn) cart.push({ game: MY_GAME, numbers, lucky });
    });
    const addAllBtn = document.getElementById('btn-add-all') as HTMLButtonElement;
    addAllBtn.textContent = '✓ todas';
    addAllBtn.classList.add('added');
    renderCart();
    syncBetButtons();
  });

  // ── Clear cart ────────────────────────────────
  document.getElementById('cart-clear')!.addEventListener('click', () => {
    cart.length = 0;
    renderCart();
  });

  // ── Session cache ─────────────────────────────
  const SESSION_KEY = 'jsc-ext-session';
  const SESSION_TTL = 4 * 60 * 1000;
  const getCachedSession = (): string | null => {
    try {
      const raw = localStorage.getItem(SESSION_KEY);
      if (!raw) return null;
      const { id, ts } = JSON.parse(raw);
      if (Date.now() - ts < SESSION_TTL) return id;
      localStorage.removeItem(SESSION_KEY);
    } catch {}
    return null;
  };
  const cacheSession = (id: string) => {
    try { localStorage.setItem(SESSION_KEY, JSON.stringify({ id, ts: Date.now() })); } catch {}
  };

  // ── Checkout ──────────────────────────────────
  checkoutBtn.addEventListener('click', async () => {
    if (cart.length === 0) return;
    checkoutBtn.disabled = true;
    checkoutBtn.textContent = 'A processar...';
    checkoutStatus.className = 'checkout-status';
    checkoutStatus.textContent = '';

    let ok = false;
    try {
      let sessionId: string | null = getCachedSession();
      for (const game of ['totoloto', 'euromilhoes', 'eurodreams'] as const) {
        const bets = cart.filter(b => b.game === game);
        if (bets.length === 0) continue;
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ game, bets, sessionId }),
        });
        const data = await res.json();
        if (!data.ok) throw new Error(data.error || 'Checkout failed');
        sessionId = data.sessionId;
      }
      if (sessionId) {
        cacheSession(sessionId);
        await new Promise<void>(resolve => {
          const listener = (e: MessageEvent) => {
            if (e.data?.type === 'JSC_SET_SESSION_ACK') {
              window.removeEventListener('message', listener);
              resolve();
            }
          };
          window.addEventListener('message', listener);
          window.postMessage({ type: 'JSC_SET_SESSION', sessionId }, '*');
          setTimeout(() => { window.removeEventListener('message', listener); resolve(); }, 3000);
        });
        window.open('https://www.jogossantacasa.pt/web/JogarApostar/', '_blank');
        ok = true;
      }
    } catch {}

    if (ok) {
      cart.length = 0;
      (document.getElementById('smart-results') as HTMLElement).innerHTML = '';
      renderCart();
      cartItemsEl.innerHTML = `<div class="cart-success">Apostas enviadas com sucesso! Boa sorte!<br><span>Confira sempre os boletins antes de pagar.</span></div>`;
      cartPanel.hidden = false;
      cartToggle.setAttribute('aria-expanded', 'true');
      checkoutStatus.textContent = '';
      checkoutStatus.className = 'checkout-status';
    } else {
      checkoutStatus.className = 'checkout-status err';
      checkoutStatus.textContent = 'Ocorreu um erro inesperado. Tenta novamente.';
    }

    checkoutBtn.disabled = false;
    checkoutBtn.textContent = 'Finalizar Aposta';
  });
</script>

<!-- ── Cell detail panel ───────────────────── -->
<div id="cell-detail" class="cell-detail" hidden role="dialog" aria-label="Detalhes do número">
  <div class="cell-detail-hero">
    <div>
      <div class="cell-detail-type"></div>
      <div class="cell-detail-num"></div>
    </div>
    <button class="cell-detail-close" aria-label="Fechar">✕</button>
  </div>
  <div class="cell-detail-body"></div>
</div>

<script>
  const panel      = document.getElementById('cell-detail')!;
  const panelNum   = panel.querySelector('.cell-detail-num')!  as HTMLElement;
  const panelType  = panel.querySelector('.cell-detail-type')! as HTMLElement;
  const panelBody  = panel.querySelector('.cell-detail-body')! as HTMLElement;
  let activeCell: HTMLElement | null = null;

  function showDetail(cell: HTMLElement) {
    const { num, draws, pct, lastDraw, lastDate, absences, type } = cell.dataset as Record<string, string>;
    const isLucky = type === 'lucky';
    const color   = isLucky ? 'var(--primary)' : 'var(--blue)';

    panelType.textContent  = isLucky ? 'Número da Sorte' : 'Número';
    panelNum.textContent   = num;
    panelNum.style.color   = color;

    panelBody.innerHTML = [
      ['Saídas',          `${draws}× (${pct}%)`],
      ['Último sorteio',  lastDraw],
      ['Data',            lastDate],
      ['Ausências',       `${absences} sorteios`],
    ].map(([lbl, val]) =>
      `<div class="cell-detail-row"><span class="lbl">${lbl}</span><span class="val">${val}</span></div>`
    ).join('');

    panel.removeAttribute('hidden');
    positionPanel(cell);
    activeCell = cell;
    (panel.querySelector('.cell-detail-close') as HTMLElement).focus();
  }

  function positionPanel(cell: HTMLElement) {
    const r  = cell.getBoundingClientRect();
    const pw = panel.offsetWidth  || 210;
    const ph = panel.offsetHeight || 170;
    const gap = 8;

    let left = r.right + gap;
    let top  = r.top;

    if (left + pw > window.innerWidth  - gap) left = r.left - pw - gap;
    if (left < gap) left = gap;
    if (top  + ph > window.innerHeight - gap) top  = window.innerHeight - ph - gap;
    if (top  < gap) top  = gap;

    panel.style.left = `${left}px`;
    panel.style.top  = `${top}px`;
  }

  function closePanel() {
    panel.setAttribute('hidden', '');
    const prev = activeCell;
    activeCell = null;
    (prev as HTMLElement | null)?.focus();
  }

  document.querySelectorAll<HTMLElement>('.freq-cell').forEach(cell => {
    cell.addEventListener('click', e => {
      e.stopPropagation();
      activeCell === cell ? closePanel() : showDetail(cell);
    });
    cell.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        activeCell === cell ? closePanel() : showDetail(cell);
      }
    });
  });

  panel.querySelector('.cell-detail-close')!.addEventListener('click', e => {
    e.stopPropagation();
    closePanel();
  });

  panel.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') closePanel();
  });

  document.addEventListener('click', e => {
    if (activeCell && !panel.contains(e.target as Node)) closePanel();
  });

  // Make tooltip-bearing non-interactive elements keyboard-reachable
  document.querySelectorAll<HTMLElement>('.has-tip').forEach(el => {
    if (!el.title && el.dataset.tip) el.title = el.dataset.tip;
    if (!['BUTTON', 'A', 'INPUT'].includes(el.tagName) && !el.getAttribute('tabindex')) {
      el.setAttribute('tabindex', '0');
    }
  });
</script>



