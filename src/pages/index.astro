            <div class="stat-chip-val" style="color:var(--blue)">{mostFrequent.number}</div>
            <div class="stat-chip-sub">{mostFrequent.draws}× · {mostFrequent.pct.toFixed(2)}%</div>
          </div>
        )}
        {mostAbsent && (
          <div class="stat-chip has-tip" data-tip="O número com mais sorteios consecutivos sem sair. Não significa que vá sair a seguir — cada sorteio é independente dos anteriores.">
            <div class="stat-chip-label">Mais ausente</div>
            <div class="stat-chip-val" style="color:var(--primary)">{mostAbsent.number}</div>
            <div class="stat-chip-sub">{mostAbsent.absences} sorteios</div>
          </div>
