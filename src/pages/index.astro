---
import '../styles/main.css';
import archiveRaw from '../data/totoloto.jsonl?raw';

const commitSha = (import.meta.env.CF_PAGES_COMMIT_SHA as string | undefined)?.slice(0, 7);

interface Draw { id?: string; draw: string; date: string; numbers: number[]; lucky: number; }
const rawArchive: Draw[] = archiveRaw.trim().split('\n').map(l => JSON.parse(l));
const fmtDate = (iso: string) => iso.split('-').reverse().join('/');
const archive = rawArchive;
const N = archive.length;

// ── Odd / Even ───────────────────────────────
const oddDist = [0,1,2,3,4,5].map(k => ({
  k,
  count: archive.filter(d => d.numbers.filter(n => n % 2 !== 0).length === k).length,
}));
const avgOdd  = +(archive.reduce((s,d) => s + d.numbers.filter(n => n % 2 !== 0).length, 0) / N).toFixed(1);
const avgEven = +(5 - avgOdd).toFixed(1);

// ── High / Low (25–49 = high) ────────────────
const hiLoDist = [0,1,2,3,4,5].map(k => ({
  k,
  count: archive.filter(d => d.numbers.filter(n => n >= 25).length === k).length,
}));
const avgHigh = +(archive.reduce((s,d) => s + d.numbers.filter(n => n >= 25).length, 0) / N).toFixed(1);
const avgLow  = +(5 - avgHigh).toFixed(1);

// ── Sums ─────────────────────────────────────
const sums   = archive.map(d => d.numbers.reduce((a,b) => a+b, 0));
const sumMin = Math.min(...sums);
const sumMax = Math.max(...sums);
const sumAvg = Math.round(sums.reduce((a,b) => a+b, 0) / N);
const BUCKET = 20, BMIN = 15, NBUCKETS = 12;
const sumHist = Array.from({length: NBUCKETS}, (_, i) => {
  const lo = BMIN + i * BUCKET;
  return { lo, hi: lo + BUCKET, count: sums.filter(s => s >= lo && s < lo + BUCKET).length };
});
const sumHistMax = Math.max(...sumHist.map(b => b.count));

// ── Zones (decades) ──────────────────────────
const zones = [
  {label:'1–10',  lo:1,  hi:10},
  {label:'11–20', lo:11, hi:20},
  {label:'21–30', lo:21, hi:30},
  {label:'31–40', lo:31, hi:40},
  {label:'41–49', lo:41, hi:49},
];
const zoneStats = zones.map(z => ({
  ...z,
  avg: +(archive.reduce((s,d) => s + d.numbers.filter(n => n >= z.lo && n <= z.hi).length, 0) / N).toFixed(2),
}));
const zoneMax = Math.max(...zoneStats.map(z => z.avg));

// ── Consecutive pairs ────────────────────────
const consecDraws = archive.filter(d => {
  const s = [...d.numbers].sort((a,b) => a-b);
  return s.some((_,i) => i > 0 && s[i] - s[i-1] === 1);
}).length;
const consecPct = Math.round(consecDraws / N * 100);

// ── Longest consecutive streak distribution ──
function longestStreak(nums: number[]): number {
  const s = [...nums].sort((a,b) => a-b);
  let max = 1, cur = 1;
  for (let i = 1; i < s.length; i++) {
    cur = s[i] - s[i-1] === 1 ? cur + 1 : 1;
    if (cur > max) max = cur;
  }
  return max;
}
const streakDist = [1,2,3,4,5].map(k => ({
  k,
  count: archive.filter(d => longestStreak(d.numbers) === k).length,
}));

// ── Carry-over between consecutive draws ────────
const carryDist = [0,1,2,3,4,5].map(k => {
  let count = 0;
  for (let i = 1; i < archive.length; i++) {
    const prev = new Set(archive[i-1].numbers);
    if (archive[i].numbers.filter(n => prev.has(n)).length === k) count++;
  }
  return { k, count };
});
const carryPairs = archive.length - 1;
const avgCarry = +(archive.slice(1).reduce((s, d, i) => {
  const prev = new Set(archive[i].numbers);
  return s + d.numbers.filter(n => prev.has(n)).length;
}, 0) / carryPairs).toFixed(2);
const luckyCarry = archive.slice(1).filter((d, i) => d.lucky === archive[i].lucky).length;
const luckyCarryPct = Math.round(luckyCarry / carryPairs * 100);

// ── Top co-occurring pairs ────────────────────
const pairFreq: Record<string, number> = {};
for (const d of archive) {
  const n = d.numbers;
  for (let i = 0; i < n.length; i++)
    for (let j = i+1; j < n.length; j++)
      { const k = `${n[i]}–${n[j]}`; pairFreq[k] = (pairFreq[k]||0) + 1; }
}
const sortedPairs = Object.entries(pairFreq).sort((a,b) => b[1]-a[1]);
const topPairs    = sortedPairs.slice(0, 12).map(([pair, count]) => ({pair, count}));
const bottomPairs = sortedPairs.slice(-12).reverse().map(([pair, count]) => ({pair, count}));

interface NumStat {
  number:   number;
  draws:    number;
  pct:      number;
  lastDraw: string;
  lastDate: string;
  absences: number;
}

let mainStats:  NumStat[] = [];
let luckyStats: NumStat[] = [];
let updatedAt = '';

try {
  const res = await fetch('https://www.jogossantacasa.pt/web/SCEstatisticas/totolotoN', {
    headers: { 'User-Agent': 'Mozilla/5.0 (compatible)' },
    signal: AbortSignal.timeout(8000),
  });
  const buf  = await res.arrayBuffer();
  const html = new TextDecoder('iso-8859-1').decode(buf);

  const rowRx = /<ul class="colums[^"]*">\s*<li>(\d+)<\/li><li>(\d+)<\/li><li>([\d,]+)<\/li><li>([^<]+)<\/li><li>([^<]+)<\/li><li>(\d+)<\/li>/g;
  const all: NumStat[] = [];
  let m: RegExpExecArray | null;
  while ((m = rowRx.exec(html)) !== null) {
    all.push({
      number:   parseInt(m[1]),
      draws:    parseInt(m[2]),
      pct:      parseFloat(m[3].replace(',', '.')),
      lastDraw: m[4].trim(),
      lastDate: m[5].trim(),
      absences: parseInt(m[6]),
    });
  }
  mainStats  = all.slice(0, 49);
  luckyStats = all.slice(49);

  const dm = html.match(/Dados atualizados em: ([\d/]+ [\d:]+)/);
  updatedAt = dm ? dm[1] : '';
} catch (_) {}

const hasData   = mainStats.length === 49;
const maxMain   = hasData ? Math.max(...mainStats.map(s => s.draws)) : 1;
const maxLucky  = luckyStats.length > 0 ? Math.max(...luckyStats.map(s => s.draws)) : 1;

const totalSorteios = hasData
  ? Math.round(mainStats.reduce((sum, s) => sum + s.draws, 0) / 5)
  : 0;
const mostFrequent = hasData ? mainStats.reduce((a, b) => b.draws    > a.draws    ? b : a) : null;
const mostAbsent   = hasData ? mainStats.reduce((a, b) => b.absences > a.absences ? b : a) : null;
const hotMain      = hasData ? [...mainStats].sort((a, b) => b.draws    - a.draws)    .slice(0, 5) : [];
const coldMain     = hasData ? [...mainStats].sort((a, b) => b.absences - a.absences) .slice(0, 5) : [];
const hotLucky     = luckyStats.length > 0 ? [...luckyStats].sort((a, b) => b.draws    - a.draws)    .slice(0, 5) : [];
const coldLucky    = luckyStats.length > 0 ? [...luckyStats].sort((a, b) => b.absences - a.absences) .slice(0, 5) : [];

// ── Last draw ────────────────────────────────
const lastDraw = archive[archive.length - 1];
const last10   = archive.slice(-10);

// ── Smart picker data ────────────────────────
const sortedSums = [...sums].sort((a,b) => a-b);
const sumP10 = sortedSums[Math.floor(N * 0.10)];
const sumP90 = sortedSums[Math.floor(N * 0.90)];
const mainFreqW  = hasData ? mainStats.map(s => s.draws)        : Array(49).fill(1);
const luckyFreqW = luckyStats.length > 0 ? luckyStats.map(s => s.draws)        : Array(13).fill(1);
const mainAbsW   = hasData ? mainStats.map(s => s.absences + 1) : Array(49).fill(1);
const luckyAbsW  = luckyStats.length > 0 ? luckyStats.map(s => s.absences + 1) : Array(13).fill(1);

const SITE_URL = 'https://totoloto.lixo.dev'; // update when deployed

function cellStyle(draws: number, max: number, isLucky: boolean) {
  const intensity = draws / max;
  const alpha     = (intensity * 0.78 + 0.04).toFixed(2);
  const rgb       = isLucky ? '230,117,65' : '0,141,208';
  const textColor = intensity > 0.38 ? '#fff' : '#111';
  return `background:rgba(${rgb},${alpha});color:${textColor}`;
}
