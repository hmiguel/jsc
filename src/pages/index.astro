<script>
  function pickNumbers(count: number, max: number): number[] {
    const pool = Array.from({ length: max }, (_, i) => i + 1);
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    return pool.slice(0, count).sort((a, b) => a - b);
  }

  function renderLine(main: number[], lucky: number, index: number): string {
    const balls    = main.map(n => `<span class="ball">${n}</span>`).join('');
    const luckyBall = `<span class="ball ball--lucky" title="Número da sorte">${lucky}</span>`;
    return `
      <div class="bet-entry" data-numbers="${main.join(',')}" data-lucky="${lucky}">
        <div class="line" aria-label="Chave ${index + 1}">
          <span class="line-label">Chave ${index + 1}</span>
          <div class="balls">${balls}<span class="balls-sep">+</span>${luckyBall}</div>
        </div>
        <div class="bet-actions">
          <button class="btn-add-cart">+ Carrinho</button>
        </div>
      </div>`;
  }

  document.getElementById('generate-btn')!.addEventListener('click', () => {
    const input = document.getElementById('lines-input') as HTMLInputElement;
    const count = Math.max(1, Math.min(20, parseInt(input.value, 10) || 1));
    const results = document.getElementById('results')!;

    results.innerHTML = Array.from({ length: count }, (_, i) => {
      const main  = pickNumbers(5, 49);
      const lucky = pickNumbers(1, 13)[0];
      return renderLine(main, lucky, i);
    }).join('');
  });
</script>

<!-- ── Smart picker script ──────────────────── -->
<script define:vars={{ mainFreqW, luckyFreqW, mainAbsW, luckyAbsW, sumP10, sumP90, lastDraw }}>

  // ── Helpers ─────────────────────────────────
  function weightedSample(weights, count) {
    const pool = weights.map((w, i) => ({ i, w: Math.max(w, 0.01) }));
    const result = [];
    while (result.length < count) {
      const total = pool.reduce((s, x) => s + x.w, 0);
      let r = Math.random() * total;
      for (const item of pool) {
        r -= item.w;
        if (r <= 0) { result.push(item.i + 1); item.w = 0; break; }
      }
    }
    return result.sort((a, b) => a - b);
  }

  function pickLucky(weights) {
    return weightedSample(weights, 1)[0];
  }

  // Equilibrada: rejection sampling with pattern filters
  function pickEquilibrada() {
    for (let t = 0; t < 2000; t++) {
      const pool = Array.from({ length: 49 }, (_, i) => i + 1);
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }
      const nums = pool.slice(0, 5).sort((a, b) => a - b);
      const odd  = nums.filter(n => n % 2 !== 0).length;
      const high = nums.filter(n => n >= 25).length;
      const sum  = nums.reduce((a, b) => a + b, 0);
      const decades = new Set(nums.map(n => Math.ceil(n / 10))).size;
      if (odd >= 2 && odd <= 3 && high >= 2 && high <= 3 && sum >= sumP10 && sum <= sumP90 && decades >= 3)
        return nums;
    }
    return weightedSample(Array(49).fill(1), 5);
  }

  const strategies = {
    equilibrada: { pick: pickEquilibrada, luckyW: luckyFreqW },
    quente:      { pick: () => weightedSample(mainFreqW, 5), luckyW: luckyFreqW },
    fria:        { pick: () => weightedSample(mainAbsW,  5), luckyW: luckyAbsW  },
  };

  const descs = {
    equilibrada: `Filtra combinações que seguem os padrões mais frequentes: 2–3 ímpares, 2–3 altos, soma entre ${sumP10} e ${sumP90}.`,
    quente:      'Favorece números com mais saídas históricas — os mais frequentes do arquivo.',
    fria:        'Favorece números com mais sorteios de ausência — os mais "atrasados" historicamente.',
  };

  // ── Annotation ──────────────────────────────
  function annotate(nums) {
    const odd  = nums.filter(n => n % 2 !== 0).length;
    const even = 5 - odd;
    const high = nums.filter(n => n >= 25).length;
    const low  = 5 - high;
    const sum  = nums.reduce((a, b) => a + b, 0);
    const oddOk  = odd >= 2 && odd <= 3;
    const highOk = high >= 2 && high <= 3;
    const sumOk  = sum >= sumP10 && sum <= sumP90;
    return `<div class="chave-annotation">
      <span class="${oddOk  ? 'ann-ok' : 'ann-warn'}">${odd}í+${even}p</span>
      <span class="${highOk ? 'ann-ok' : 'ann-warn'}">${low}bx+${high}alt</span>
      <span class="${sumOk  ? 'ann-ok' : 'ann-warn'}">Σ ${sum}</span>
      <button class="btn-add-cart" style="margin-left:auto">+ Carrinho</button>
    </div>`;
  }

  // ── Render ───────────────────────────────────
  function renderSmartLine(nums, lucky, index) {
    const balls = nums.map(n => `<span class="ball">${n}</span>`).join('');
    const luckyBall = `<span class="ball ball--lucky">${lucky}</span>`;
    return `
      <div class="bet-entry" data-numbers="${nums.join(',')}" data-lucky="${lucky}">
        <div class="line" aria-label="Chave ${index + 1}">
          <span class="line-label">Chave ${index + 1}</span>
          <div class="balls">${balls}<span class="balls-sep">+</span>${luckyBall}</div>
        </div>
        ${annotate(nums)}
      </div>`;
  }

  // ── State ────────────────────────────────────
  let currentStrategy = 'equilibrada';

  // Strategy pills
  document.querySelectorAll('.strategy-pill').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.strategy-pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentStrategy = btn.dataset.strategy;
      document.getElementById('strategy-desc').textContent = descs[currentStrategy];
    });
  });

  // Generate
  document.getElementById('smart-btn').addEventListener('click', () => {
    const input       = document.getElementById('smart-lines-input');
    const count       = Math.max(1, Math.min(20, parseInt(input.value, 10) || 1));
    const avoidRepeat = document.getElementById('avoid-repeats').checked;
    const excluded    = avoidRepeat ? new Set(lastDraw.numbers) : new Set();
    const { luckyW }  = strategies[currentStrategy];
    const results     = document.getElementById('smart-results');

    function pickWithFilter() {
      const { pick } = strategies[currentStrategy];
      for (let t = 0; t < 500; t++) {
        const nums = pick();
        if (!nums.some(n => excluded.has(n))) return nums;
      }
      return strategies[currentStrategy].pick();
    }

    results.innerHTML = Array.from({ length: count }, (_, i) =>
      renderSmartLine(pickWithFilter(), pickLucky(luckyW), i)
    ).join('');
  });
</script>

<!-- ── Cart script ──────────────────────────── -->
<script>
  // ── State ────────────────────────────────────
  const cart: { numbers: number[]; lucky: number }[] = [];

  const cartToggle     = document.getElementById('cart-toggle') as HTMLButtonElement;
  const cartPanel      = document.getElementById('cart-panel')!;
  const cartItemsEl    = document.getElementById('cart-items')!;
  const cartBadgeEl    = document.getElementById('cart-badge')!;
  const checkoutBtn    = document.getElementById('checkout-btn') as HTMLButtonElement;
  const checkoutStatus = document.getElementById('checkout-status')!;

  // ── Extension detection ───────────────────────
  checkoutBtn.disabled = true;
  checkoutStatus.textContent = 'Extensão Chrome não instalada';
  checkoutStatus.className = 'checkout-status err';

  const onExtReady = (e: MessageEvent) => {
    if (e.origin !== location.origin) return;
    if (e.data?.type !== 'JSC_EXT_READY') return;
    checkoutBtn.disabled = false;
    checkoutStatus.textContent = '';
    checkoutStatus.className = 'checkout-status';
    window.removeEventListener('message', onExtReady);
  };
  window.addEventListener('message', onExtReady);
  // Ping the extension — if it loaded first it will respond; if it loads
  // later it will announce itself via JSC_EXT_READY automatically.
  window.postMessage({ type: 'JSC_EXT_PING' }, '*');

  function renderCart() {
    const n = cart.length;
    cartBadgeEl.textContent = String(n);
    cartBadgeEl.hidden = n === 0;
    cartToggle.classList.toggle('has-items', n > 0);
    if (n === 0) cartPanel.hidden = true;

    cartItemsEl.innerHTML = cart.map((bet, i) => {
      const balls = bet.numbers.map(n => `<span class="cart-ball">${n}</span>`).join('');
      const lucky = `<span class="cart-ball cart-ball--lucky">${bet.lucky}</span>`;
      return `
        <div class="cart-item">
          <span class="cart-item-label">Chave ${i + 1}</span>
          <div class="cart-balls">${balls}<span class="cart-balls-sep">+</span>${lucky}</div>
          <button class="btn-cart-remove" data-idx="${i}" title="Remover">✕</button>
        </div>`;
    }).join('');

    cartItemsEl.querySelectorAll<HTMLButtonElement>('[data-idx]').forEach(btn => {
      btn.addEventListener('click', e => {
        e.stopPropagation();
        cart.splice(Number(btn.dataset.idx), 1);
        renderCart();
      });
    });
  }

  // ── Toggle panel ──────────────────────────────
  cartToggle.addEventListener('click', e => {
    e.stopPropagation();
    if (cart.length > 0) cartPanel.hidden = !cartPanel.hidden;
  });

  document.addEventListener('click', e => {
    if (!cartPanel.hidden && !cartPanel.contains(e.target as Node)) {
      cartPanel.hidden = true;
    }
  });

  // ── Add to cart via event delegation ─────────
  function setupAddListeners(containerId: string) {
    document.getElementById(containerId)!.addEventListener('click', e => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.btn-add-cart');
      if (!btn) return;
      const entry = btn.closest<HTMLElement>('[data-numbers]');
      if (!entry) return;
      const numbers = entry.dataset.numbers!.split(',').map(Number);
      const lucky   = Number(entry.dataset.lucky);
      cart.push({ numbers, lucky });
      renderCart();
      btn.textContent = '✓ Adicionado';
      btn.classList.add('added');
    });
  }

  setupAddListeners('results');
  setupAddListeners('smart-results');

  // ── Clear cart ────────────────────────────────
  document.getElementById('cart-clear')!.addEventListener('click', () => {
    cart.length = 0;
    renderCart();
  });

  // ── Checkout ──────────────────────────────────
  checkoutBtn.addEventListener('click', async () => {
    if (cart.length === 0) return;
    checkoutBtn.disabled = true;
    checkoutBtn.textContent = 'A processar...';
    checkoutStatus.className = 'checkout-status';
    checkoutStatus.textContent = '';

    try {
      const resp = await fetch('/api/basket', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ bets: cart }),
      });
      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
      const data = await resp.json();
      if (!data.jsessionid) throw new Error('Sessão inválida');

      // Signal extension to inject cookie + open tab
      let ack = false;
      const ackListener = (e: MessageEvent) => {
        if (e.data?.type === 'JSC_CHECKOUT_ACK') { ack = true; }
      };
      window.addEventListener('message', ackListener);
      window.postMessage({ type: 'JSC_CHECKOUT', jsessionid: data.jsessionid }, '*');

      await new Promise(r => setTimeout(r, 600));
      window.removeEventListener('message', ackListener);

      if (!ack) {
        // Extension not installed — open tab directly (basket won't be pre-filled)
        window.open('https://www.jogossantacasa.pt/web/JogarApostar/', '_blank');
        checkoutStatus.className = 'checkout-status err';
        checkoutStatus.textContent = 'Instala a extensão Chrome para pré-preencher o carrinho.';
      } else {
        checkoutStatus.className = 'checkout-status ok';
        checkoutStatus.textContent = 'Carrinho enviado para o JSC!';
      }

      cart.length = 0;
      renderCart();
      (document.getElementById('results') as HTMLElement).innerHTML = '';
      (document.getElementById('smart-results') as HTMLElement).innerHTML = '';
    } catch (err: any) {
      checkoutStatus.className = 'checkout-status err';
      checkoutStatus.textContent = `Erro: ${err.message}`;
    } finally {
      checkoutBtn.disabled = false;
      checkoutBtn.textContent = 'Finalizar Aposta →';
    }
  });
</script>

